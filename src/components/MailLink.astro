---
import { site } from '../data/site';

interface Props {
  label?: string;
  subject?: string;
}

const { label = 'Reach out', subject } = Astro.props;
const query = subject ? `?subject=${encodeURIComponent(subject)}` : '';
---

<a
  href={`mailto:${site.email}${query}`}
  class="cursor-alias rounded text-neutral-900 underline decoration-rose-400 underline-offset-4 transition-colors hover:text-neutral-500 focus-visible:ring-4 focus-visible:ring-blue-200"
>
  {label}
</a>
