---
import type { Paper } from '../lib/types';
import { site } from '../data/site';
import { asset } from '../lib/paths';

interface Props {
  paper: Paper;
  category?: string;
  index?: number;
}

const { paper, category = 'Research', index = 0 } = Astro.props;
const { title, authors, venue, venueHref, year, note, figure, figureHref, links = {} } = paper;

const {
  imageBleed,
  imageBleedTop = 40,
  imageBleedLeft = 16,
  imageBleedCenter = false,
  imageBleedMinHeight,
  imageBorder,
  imageBorderWidth = 1,
  imageBorderRadius = 6,
} = paper;
const bleeds = typeof imageBleed === 'number' && !!figure;

const imageBorderStyle = imageBorder
  ? `border: ${imageBorderWidth}px solid ${imageBorder}; border-radius: ${imageBorderRadius}px`
  : undefined;

const bleedGutter = imageBleedLeft + (imageBleedCenter ? imageBleedLeft : 16);

const minHeight = bleeds && imageBleedMinHeight ? imageBleedMinHeight : undefined;

const githubLink = /^https?:\/\/(www\.)?github\.com\//.test(links.code ?? '')
  ? links.code
  : undefined;

const primary =
  links.pdf ?? links.slides ?? links.arxiv ?? links.video ?? links.project ?? (githubLink ? undefined : links.code);

const figureLink = figureHref ?? primary ?? githubLink;
const figureDuplicatesArrow = figureLink === primary;
const figureLinkProps = figureLink
  ? {
      href: figureLink,
      target: '_blank',
      rel: 'noreferrer',
      ...(figureDuplicatesArrow
        ? { tabindex: '-1', 'aria-hidden': 'true' }
        : { 'aria-label': `${title} — figure link` }),
    }
  : {};
const FigureLink = figureLink ? 'a' : 'div';

const linkLabels: Array<[keyof typeof links, string]> = [
  ['pdf', 'PDF'],
  ['arxiv', 'arXiv'],
  ['slides', 'Slides'],
  ['video', 'Video'],
  ['code', 'Code'],
  ['project', 'Project'],
  ['bibtex', 'BibTeX'],
];
const secondary = linkLabels
  .map(([key, label]) => ({ label, url: links[key] }))
  .filter((l): l is { label: string; url: string } => !!l.url);
---

<div class="px-1 pb-2">
  <div
    class:list={[
      'animate-fade-up group h-full w-full overflow-hidden rounded-lg bg-neutral-50 transition-colors focus-within:bg-neutral-100 hover:bg-neutral-100',
      minHeight && 'sm:[min-height:var(--bleed-min-h)]',
    ]}
    style={[
      `animation-delay: ${index * 60}ms`,
      minHeight && `--bleed-min-h: ${minHeight}px`,
    ]
      .filter(Boolean)
      .join('; ')}
  >
    <div class="relative isolate flex h-full w-full flex-col">
      <div
        class="flex items-center justify-between pt-2 pr-2 pl-4 text-sm tracking-tight text-neutral-400"
      >
        <span class="min-w-0 truncate py-1.5">{category} · {year}</span>
        <span class="flex shrink-0 items-center">
        {
          githubLink && (
            <a
              href={githubLink}
              target="_blank"
              rel="noreferrer"
              aria-label={`${title} on GitHub`}
              class="flex h-8 w-8 shrink-0 cursor-alias items-center justify-center rounded-full transition-colors group-focus-within:bg-white group-focus-within:text-neutral-900 group-focus-within:shadow-skeuo group-hover:bg-white group-hover:text-neutral-900 group-hover:shadow-skeuo focus-visible:ring-4 focus-visible:ring-blue-200"
            >
              <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
              </svg>
            </a>
          )
        }
        {
          primary && (
            <a
              href={primary}
              target="_blank"
              rel="noreferrer"
              aria-label={title}
              class="flex h-8 w-8 shrink-0 cursor-alias items-center justify-center rounded-full transition-colors group-focus-within:bg-white group-focus-within:text-neutral-900 group-focus-within:shadow-skeuo group-hover:bg-white group-hover:text-neutral-900 group-hover:shadow-skeuo focus-visible:ring-4 focus-visible:ring-blue-200"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          )
        }
        </span>
      </div>

      {
        bleeds && (
          <FigureLink
            {...figureLinkProps}
            class:list={['absolute -z-10 hidden sm:block', figureLink && 'cursor-alias']}
            style={`top: ${imageBleedTop}px; left: ${imageBleedLeft}px; width: ${imageBleed}%`}
          >
            <img
              src={asset(figure)}
              alt={`Teaser figure for ${title}`}
              loading="lazy"
              decoding="async"
              style={imageBorderStyle}
              class="block h-auto w-full origin-top transition-transform group-hover:scale-105"
            />
          </FigureLink>
        )
      }

      <div
        class:list={[
          'flex flex-1 flex-col gap-4 py-4 pr-4 pl-4 sm:flex-row sm:gap-6',
          bleeds && 'sm:pl-0 sm:[margin-left:var(--bleed-pad)]',
        ]}
        style={bleeds ? `--bleed-pad: calc(${imageBleed}% + ${bleedGutter}px)` : undefined}
      >
        {
          figure && (
            <div
              class:list={[
                'aspect-[4/3] w-full shrink-0 overflow-hidden rounded',
                bleeds ? 'sm:hidden' : 'sm:aspect-auto sm:w-2/5',
              ]}
            >
              <FigureLink
                {...figureLinkProps}
                class:list={['block h-full w-full', figureLink && 'cursor-alias']}
              >
                <img
                  src={asset(figure)}
                  alt={`Teaser figure for ${title}`}
                  loading="lazy"
                  decoding="async"
                  style={imageBorderStyle}
                  class="h-full w-full object-contain transition-transform group-hover:scale-105"
                />
              </FigureLink>
            </div>
          )
        }

        <div class="flex min-w-0 flex-1 flex-col">
          <h2 class="font-serif text-xl leading-tight font-light text-neutral-900 sm:text-2xl">
            {title}
          </h2>

          <p class="mt-3 text-sm tracking-tight text-neutral-400">
            {
              authors.map((name, i) => (
                <>
                  {i > 0 && ', '}
                  {name === site.author ? (
                    <span class="text-neutral-900">{name}</span>
                  ) : (
                    name
                  )}
                </>
              ))
            }
          </p>

          <p class="mt-1 text-sm tracking-tight text-neutral-400">
            {
              venueHref ? (
                <a
                  href={venueHref}
                  target="_blank"
                  rel="noreferrer"
                  class="cursor-alias rounded underline decoration-neutral-300 underline-offset-2 transition-colors hover:text-neutral-900"
                >
                  {venue}
                </a>
              ) : (
                venue
              )
            }{note && <span class="text-neutral-900"> · {note}</span>}
          </p>

          {
            secondary.length > 0 && (
              <p class="mt-auto pt-4 text-sm tracking-tight">
                {secondary.map((link, i) => (
                  <>
                    {i > 0 && <span class="text-neutral-300"> · </span>}
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noreferrer"
                      class="cursor-alias rounded text-neutral-900 underline decoration-sky-400 underline-offset-4 transition-colors hover:text-neutral-500 focus-visible:ring-4 focus-visible:ring-blue-200"
                    >
                      {link.label}
                    </a>
                  </>
                ))}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>
