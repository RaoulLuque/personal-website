---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PaperCard from '../components/PaperCard.astro';
import { talks } from '../data/talks';
---

<Base title="Talks">
  <PageHeader heading="Talks">
    Talks I&rsquo;ve given.
  </PageHeader>
  <div class="grid grid-cols-1 pb-8 lg:grid-cols-2">
    {talks.map((talk, i) => <PaperCard paper={talk} category="Talks" index={i} />)}
  </div>
</Base>
