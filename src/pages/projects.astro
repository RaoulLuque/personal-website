---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Grid from '../components/Grid.astro';
import Card from '../components/Card.astro';
import { projects } from '../data/projects';
---

<Base title="Projects">
  <PageHeader
    heading="Projects"
    intro="Things I've built and worked on in my free time or projects I help maintain."
  />
  <Grid class="pb-8">
    {
      projects.map((project, i) => (
        <Card
          category="Projects"
          title={project.title}
          href={project.href}
          githubHref={project.githubHref}
          imageHref={project.imageHref}
          imageBorder={project.imageBorder}
          imageBorderWidth={project.imageBorderWidth}
          imageBorderRadius={project.imageBorderRadius}
          image={project.image}
          blurb={project.blurb}
          wide={project.wide}
          split={project.split}
          imageFit={project.imageFit}
          imageAnchor={project.imageAnchor}
          imageBleed={project.imageBleed}
          imageBleedTop={project.imageBleedTop}
          imageBleedLeft={project.imageBleedLeft}
          imageBleedCenter={project.imageBleedCenter}
          credit={project.credit}
          creditHref={project.creditHref}
          index={i}
        />
      ))
    }
  </Grid>
</Base>
