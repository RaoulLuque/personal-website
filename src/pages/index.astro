---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { asset, href } from '../lib/paths';
import { papers } from '../data/research';
import { projects } from '../data/projects';
import { courses } from '../data/teaching';

import type { Course, Paper, Project } from '../lib/types';

const cardProps = (e: Project & Course) => ({
  title: e.title,
  blurb: e.blurb,
  image: e.image,
  href: e.href,
  githubHref: e.githubHref,
  imageHref: e.imageHref,
  wide: e.wide,
  split: e.split,
  reveal: e.reveal,
  revealOffset: e.revealOffset,
  imageFit: e.imageFit,
  imageAnchor: e.imageAnchor,
  imageBleed: e.imageBleed,
  imageBleedTop: e.imageBleedTop,
  imageBleedBottom: e.imageBleedBottom,
  imageBleedLeft: e.imageBleedLeft,
  imageBleedCenter: e.imageBleedCenter,
  imageBorder: e.imageBorder,
  imageBorderWidth: e.imageBorderWidth,
  imageBorderRadius: e.imageBorderRadius,
  credit: e.credit,
  creditHref: e.creditHref,
});

const paperProps = (p: Paper) => ({
  label: p.venue,
  title: p.title,
  image: p.figure,
  href: p.links?.pdf ?? p.links?.arxiv ?? p.links?.project,
  githubHref: /^https?:\/\/(www\.)?github\.com\//.test(p.links?.code ?? '')
    ? p.links?.code
    : undefined,
  imageHref: p.figureHref,
  imageBleed: p.imageBleed,
  imageBleedTop: p.imageBleedTop,
  imageBleedBottom: p.imageBleedBottom,
  imageBleedLeft: p.imageBleedLeft,
  imageBleedCenter: p.imageBleedCenter,
  imageBorder: p.imageBorder,
  imageBorderWidth: p.imageBorderWidth,
  imageBorderRadius: p.imageBorderRadius,
});

type CardOverrides = Partial<ReturnType<typeof cardProps>> & {
  label?: string;
  category?: string;
  categoryHref?: string;
};

const featureProject = (p: Project | undefined, overrides: CardOverrides = {}) =>
  p && {
    category: 'Projects',
    categoryHref: href('projects'),
    ...cardProps(p as Project & Course),
    ...overrides,
  };

const featureCourse = (c: Course | undefined, overrides: CardOverrides = {}) =>
  c && {
    category: 'Teaching',
    categoryHref: href('teaching'),
    label: c.term,
    ...cardProps(c as Project & Course),
    ...overrides,
  };

const featurePaper = (p: Paper | undefined, overrides: CardOverrides = {}) =>
  p && {
    category: 'Research',
    categoryHref: href('research'),
    ...paperProps(p),
    ...overrides,
  };

const cvCard = {
  category: 'CV',
  title: 'Curriculum Vitae',
  image: 'images/profile.jpg',
  href: asset('cv.pdf'),
  imageHref: asset('cv.pdf'),
  reveal: true,
};

const candidates = [
featurePaper(papers[0], {
    imageBleed: 70,
    imageBleedTop: 100,
    imageBleedBottom: 20,
    split: false,
    wide: false,
  }),
  cvCard,
  featureProject(projects[0], {
  }),
].filter((c) => c && c.title) as Array<Record<string, unknown> & { wide?: boolean }>;

const FREE_PER_ROW = 2;
const rowsFree = [FREE_PER_ROW, FREE_PER_ROW];
const placed: Array<{ card: (typeof candidates)[number]; row: number }> = [];

for (const card of candidates) {
  const cost = card.wide ? 2 : 1;
  const row = rowsFree.findIndex((free) => free >= cost);
  if (row === -1) continue;
  rowsFree[row] -= cost;
  placed.push({ card, row });
}

const featured = placed.sort((a, b) => a.row - b.row).map((p) => p.card);
---

<Base fullscreen>
  <div
    class="grid grid-cols-1 gap-0 pb-8 sm:grid-cols-2 lg:min-h-0 lg:flex-1 lg:grid-cols-4 lg:grid-rows-2 lg:pb-0"
  >
    <div class="row-span-2 px-1 pb-2 sm:col-span-2 lg:min-h-0">
      <div class="flex h-full w-full items-center p-4 sm:p-8">
        <h1
          class="font-serif text-2xl leading-tight! font-light text-neutral-400 sm:text-3xl lg:text-4xl 2xl:text-5xl"
        >
          Hi there, I&rsquo;m <span class="text-neutral-900">Raoul</span> 👋 A mathematics PhD
          student at <a
            href="https://www.rwth-aachen.de/"
            target="_blank"
            rel="noreferrer"
            class="cursor-alias rounded text-neutral-900 underline decoration-sky-400 decoration-wavy underline-offset-4 transition-colors hover:text-neutral-500 focus-visible:ring-4 focus-visible:ring-blue-200"
            >RWTH Aachen</a
          > at the chairs on <a
            href="https://www.oms.rwth-aachen.de/cms/~eikf/oms/?lidx=1"
            target="_blank"
            rel="noreferrer"
            class="cursor-alias rounded text-neutral-900 underline decoration-teal-400 underline-offset-4 transition-colors hover:text-neutral-500 focus-visible:ring-4 focus-visible:ring-blue-200"
            >Management Science</a> and <a
            href="https://www.gdm.rwth-aachen.de/cms/~bldute/gdm/?lidx=1"
            target="_blank"
            rel="noreferrer"
            class="cursor-alias rounded text-neutral-900 underline decoration-purple-400 underline-offset-4 transition-colors hover:text-neutral-500 focus-visible:ring-4 focus-visible:ring-blue-200"
            >Algorithmic Game Theory and Discrete Mathematics</a>.

          <br /><br />

          Most of my time at work goes into <a
            href={href('research')}
            class="rounded text-neutral-900 underline decoration-orange-400 underline-offset-4 hover:underline focus-visible:ring-4 focus-visible:ring-blue-200"
            >research</a

          >, however I also have the pleasure of <a
            href={href('teaching')}
            class="rounded text-neutral-900 underline decoration-fuchsia-400 underline-offset-4 hover:underline focus-visible:ring-4 focus-visible:ring-blue-200"
            >teaching</a
          >.
          
          <br /><br />

          When I find some time outside of work, I like to work on different kinds of <a
            href={href('projects')}
            class="rounded text-neutral-900 underline decoration-lime-400 underline-offset-4 hover:underline focus-visible:ring-4 focus-visible:ring-blue-200"
            >projects</a
          >.
        </h1>
      </div>
    </div>

    {
      featured.map((card, i) => (
        <Card
          {...(card as any)}
          index={i + 1}
          class="lg:aspect-auto lg:min-h-0"
        />
      ))
    }
  </div>
</Base>
