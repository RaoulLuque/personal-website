---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import MailLink from '../components/MailLink.astro';
import PaperCard from '../components/PaperCard.astro';
import { papers } from '../data/research';

---

<Base title="Research">
  <PageHeader heading="Research">
    Papers and preprints. <MailLink subject="Your research" /> if anything here interests you.
  </PageHeader>
  <div class="grid grid-cols-1 pb-8 lg:grid-cols-2">
    {papers.map((paper, i) => <PaperCard paper={paper} index={i} />)}
  </div>
</Base>
