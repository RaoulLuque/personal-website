---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import MailLink from '../components/MailLink.astro';
import PaperCard from '../components/PaperCard.astro';
import { papers } from '../data/research';

// Papers carry more text than a project thumbnail, so this page uses its own
// two-up grid rather than the shared four-column one.
const sorted = [...papers].sort((a, b) => b.year - a.year);
---

<Base title="Research">
  <PageHeader heading="Research">
    Papers and preprints. <MailLink subject="Your research" /> if anything here is relevant to
    what you&rsquo;re working on.
  </PageHeader>
  <div class="grid grid-cols-1 pb-8 lg:grid-cols-2">
    {sorted.map((paper, i) => <PaperCard paper={paper} index={i} />)}
  </div>
</Base>
