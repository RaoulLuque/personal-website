---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
import { asset } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  fullscreen?: boolean;
}

const { title, description = site.description, fullscreen = false } = Astro.props;
const pageTitle = title ? `${site.title} | ${title}` : site.title;
---

<!doctype html>
<html lang="en" class={fullscreen ? 'lg:h-dvh lg:overflow-hidden' : ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  </head>
  <body
    class={fullscreen ? 'bg-white text-neutral-900 lg:h-dvh lg:overflow-hidden' : 'bg-white text-neutral-900'}
  >
    <main
      class:list={[
        'mx-auto w-full max-w-[640px] px-8 font-sans md:max-w-[768px] lg:max-w-[1024px] xl:max-w-[1536px]',
        fullscreen && 'lg:flex lg:h-full lg:flex-col',
      ]}
    >
      <Nav />
      <slot />
    </main>

    {/*
      The only JavaScript on the site. CSS :active cannot express the card press:
      browsers revoke it the moment a touch turns into a scroll, so a card would
      snap back the instant you dragged away from it. touchend fires only when the
      finger actually lifts, so this holds the state through a scroll. Inline and
      listener-only — no bundle, no hydration, nothing to load.
    */}
    <script is:inline>
      (() => {
        let pressed = null;
        const release = () => {
          if (!pressed) return;
          pressed.classList.remove('is-pressed');
          pressed = null;
        };
        // Clearing on touchstart as well as touchend is what self-heals a card
        // left pressed by a touchcancel we never saw: the next touch resets it.
        document.addEventListener('touchstart', (e) => {
          release();
          const card = e.target instanceof Element && e.target.closest('[data-card]');
          if (!card) return;
          pressed = card;
          card.classList.add('is-pressed');
        }, { passive: true });
        document.addEventListener('touchend', release, { passive: true });
      })();
    </script>
  </body>
</html>
